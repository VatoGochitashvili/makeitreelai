# Copy this file to ".env" and fill in your keys.

# Your OpenAI API key — used for transcription (Whisper) and picking the best moments (GPT).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Port the server runs on (Replit sets this automatically; 3000 for local).
PORT=3000

# Max clips to generate per video (protects you from runaway API/render costs).
MAX_CLIPS=6

# Where persisted data (accounts, schedule, reels, voice samples) is written.
# Defaults to ./.data — set this to a mounted disk in production so accounts
# survive restarts and redeploys (e.g. DATA_DIR=/var/data on Render).
# DATA_DIR=/var/data

# Signs session cookies. Set a long random value in production so users stay
# logged in across restarts; if unset, a new one is generated on every boot.
# SESSION_SECRET=change-me-to-a-long-random-string

# --- YouTube downloading on a server -------------------------------------
# Cloud/datacenter IPs get bot-blocked by YouTube ("Sign in to confirm you're
# not a bot" / HTTP 429). To download from a server, supply ONE of:
#   YTDLP_COOKIES_B64 - base64 of a cookies.txt exported from a logged-in
#                       browser (easiest on hosts without a disk)
#   YTDLP_COOKIES     - path to a cookies.txt file
#   YTDLP_PROXY       - a residential proxy URL (http/https/socks)
# Extra raw yt-dlp args (advanced): YTDLP_ARGS="--force-ipv4"
# YTDLP_COOKIES_B64=
# YTDLP_PROXY=

# --- Free alternative to buying a proxy --------------------------------
# YouTube blocks servers but not home connections. Set WORKER_TOKEN to any
# long random string, then run the helper on a home computer:
#   SERVER_URL=https://your-app.onrender.com WORKER_TOKEN=... npm run worker
# Link downloads are then fetched on that machine and sent back, so no
# proxy is needed. Uploads/podcast/Drive never touch it.
# WORKER_TOKEN=

# ---- Billing (optional) ----
# Everything billing-related stays inert until these are set, so leaving them
# blank keeps the app exactly as it was. Create the two prices in the Stripe
# dashboard, then point the webhook at /api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PACK_SMALL=
STRIPE_PRICE_PACK_MEDIUM=
STRIPE_PRICE_PACK_LARGE=
STRIPE_WEBHOOK_SECRET=
SITE_URL=http://localhost:3000

# ---- Capacity ----
# Renders that may run at once. ffmpeg and Whisper will each take a whole box.
MAX_CONCURRENT_JOBS=1
# Days a finished clip is kept before it is swept.
CLIP_RETENTION_DAYS=30
